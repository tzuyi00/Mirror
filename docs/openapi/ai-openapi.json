        },
        "type": "object",
        "required": [
          "userId",
          "ai_question",
          "userMessage"
        ],
        "title": "MemoryExtractRequest"
      },
      "MemoryOperationResult": {
        "properties": {
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "memoryId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Memoryid"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "success"
        ],
        "title": "MemoryOperationResult"
      },
      "MemorySyncOperation": {
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete"
            ],
            "title": "Type"
          },
          "memoryId": {
            "type": "string",
            "title": "Memoryid"
          },
          "content": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "Manual Update"
          },
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories",
            "default": []
          },
          "deleteMode": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Deletemode"
          },
          "createdAt": {
            "type": "string",
            "title": "Createdat"
          }
        },
        "type": "object",
        "required": [
          "type",
          "memoryId",
          "createdAt"
        ],
        "title": "MemorySyncOperation"
      },
      "MemorySyncRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "operations": {
            "items": {
              "$ref": "#/components/schemas/MemorySyncOperation"
            },
            "type": "array",
            "title": "Operations"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "memory_modal"
          }
        },
        "type": "object",
        "required": [
          "userId",
          "operations"
        ],
        "title": "MemorySyncRequest"
      },
      "ProfileRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "title": "Userid"
          }
        },
        "type": "object",
        "required": [
          "userId"
        ],
        "title": "ProfileRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
