        },
        "type": "object",
        "required": [
          "threadId",
          "userId",
          "activityId"
        ],
        "title": "InterviewRequest"
      },
      "MemoryExtractRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "ai_question": {
            "type": "string",
            "title": "Ai Question"
          },
          "userMessage": {
            "type": "string",
            "title": "Usermessage"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "interview"
