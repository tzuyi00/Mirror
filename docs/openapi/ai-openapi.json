  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "threadId": {
            "type": "string",
            "title": "Threadid"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "existingMemories": {
            "anyOf": [
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Existingmemories"
          }
        },
        "type": "object",
        "required": [
          "threadId",
          "message",
          "userId"
        ],
        "title": "ChatRequest"
      },
      "FeedbackRequest": {
        "properties": {
          "threadId": {
            "type": "string",
            "title": "Threadid"
          },
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "operationResults": {
            "items": {
              "$ref": "#/components/schemas/MemoryOperationResult"
            },
            "type": "array",
            "title": "Operationresults"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "conversation"
          }
        },
        "type": "object",
        "required": [
          "threadId",
          "userId",
          "operationResults"
        ],
        "title": "FeedbackRequest"
      },
      "GEvalResponse": {
        "properties": {
          "score": {
            "type": "number",
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "score"
        ],
        "title": "GEvalResponse"
      },
      "GevalRequest": {
        "properties": {
          "userId": {
            "type": "string",
            "title": "Userid"
          }
        },
        "type": "object",
        "required": [
          "userId"
        ],
        "title": "GevalRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InterviewRequest": {
        "properties": {
          "threadId": {
            "type": "string",
            "title": "Threadid"
          },
          "userMessage": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usermessage"
          },
          "userId": {
            "type": "string",
            "title": "Userid"
          },
          "activityId": {
            "type": "string",
            "title": "Activityid"
          },
          "userMessageId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Usermessageid"
          },
