        "tags": ["Private"],
        "summary": "GET /api/thread/{threadId}/messages",
        "description": "/api/thread/{threadId}/messages\nGet all messages for a specific thread",
        "operationId": "GetThreadMessages",
        "parameters": [
          {
            "description": "The thread ID to fetch messages for",
            "in": "path",
