        "summary": "POST /api/profile/trigger-auto-update",
        "description": "/api/profile/trigger-auto-update\nTrigger profile auto-update after memory operations",
        "operationId": "TriggerAutoUpdate",
        "parameters": [],
        "requestBody": {
          "description": "Auto-update request with userId and successCount",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TriggerAutoUpdateRequest",
