  "components": {
    "schemas": {
      "ThreadCreateResponse": {
        "properties": {
          "threadId": { "type": "string" },
          "createdAt": { "type": "string" }
        },
        "required": ["threadId", "createdAt"],
        "type": "object",
        "additionalProperties": true
      },
      "ThreadMessagesResponse": {
        "properties": {
          "threadId": { "type": "string" },
          "messages": {
            "items": {
              "properties": {
                "data": {},
                "role": { "type": "string" },
                "createdAt": { "type": "string" },
                "id": { "type": "string" }
              },
              "required": ["data", "role", "createdAt", "id"],
              "type": "object"
            },
            "type": "array"
          }
        },
        "required": ["threadId", "messages"],
        "type": "object",
        "additionalProperties": true
      },
      "GenerateProfileRequest": {
        "properties": {
          "userId": { "type": "string" }
        },
        "type": "object",
        "additionalProperties": true
      },
      "TriggerAutoUpdateRequest": {
        "properties": {
          "userId": { "type": "string" },
          "successCount": { "type": "number", "format": "double" }
        },
        "required": ["userId", "successCount"],
        "type": "object",
        "additionalProperties": true
      },
      "GEvalRequest": {
        "properties": {
          "userId": { "type": "string" }
        },
        "required": ["userId"],
        "type": "object",
        "additionalProperties": true
      },
      "CreateMemoryRequest": {
        "properties": {
          "userId": { "type": "string" },
          "type": { "type": "string", "enum": ["user", "ai"] },
          "content": { "type": "string" },
          "source": { "type": "string" },
          "categories": { "items": { "type": "string" }, "type": "array" },
          "sectionIds": { "items": { "type": "string" }, "type": "array" }
        },
        "required": ["userId", "type", "content"],
        "type": "object",
        "additionalProperties": true
      },
      "UpdateMemoryRequest": {
        "properties": {
          "content": { "type": "string" },
          "source": { "type": "string" },
          "categories": { "items": { "type": "string" }, "type": "array" }
        },
        "type": "object",
        "additionalProperties": true
      },
      "ErrorInfo": {
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" }
        },
        "required": ["code", "message"],
        "type": "object",
        "additionalProperties": true
      },
      "MetaData": {
        "description": "Common DTO types used across multiple endpoints",
        "properties": {
          "userId": { "type": "string" },
          "threadId": { "type": "string" },
          "messageId": { "type": "string" },
          "createdAt": { "type": "string" }
        },
        "required": ["userId", "createdAt"],
        "type": "object",
        "additionalProperties": true
      },
      "ChatReplyResponse": {
        "properties": {
          "ok": { "type": "boolean" },
          "reply": { "type": "string" },
          "error": { "$ref": "#/components/schemas/ErrorInfo" },
          "meta": { "$ref": "#/components/schemas/MetaData" }
        },
        "required": ["ok", "meta"],
        "type": "object",
        "additionalProperties": true
      },
      "ChatRequest": {
        "properties": {
          "userId": { "type": "string" },
          "message": { "type": "string" },
          "threadId": { "type": "string" }
        },
        "required": ["userId", "message"],
        "type": "object",
        "additionalProperties": true
      },
      "MemoryOperationResult": {
        "properties": {
          "success": { "type": "boolean" },
          "memoryId": { "type": "string" },
          "error": { "type": "string" }
        },
        "required": ["success"],
        "type": "object",
        "additionalProperties": true
      },
      "ProfileAutoUpdateInfo": {
        "properties": {
          "triggered": { "type": "boolean" },
          "message": { "type": "string" },
          "profileData": {}
        },
        "required": ["triggered", "message"],
