{
  "openapi": "3.1.0",
  "info": {
    "title": "Me 2 Backend API",
    "description": "Backend Server API endpoints for Me 2 - Node.js/Express",
    "version": "1.0.0"
  },
  "tags": [
    { "name": "Public", "description": "Publicly accessible APIs" },
    { "name": "Private", "description": "Private APIs for internal use" }
  ],
  "paths": {
    "/api/chat/reply": {
      "post": {
        "tags": ["Private"],
        "summary": "POST /api/chat/reply",
        "description": "/api/chat/reply\nSend a message to the AI and receive only the reply text",
        "operationId": "Reply",
        "parameters": [],
        "requestBody": {
          "description": "The chat request containing userId, message, and optional threadId",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest",
                "description": "The chat request containing userId, message, and optional threadId"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Simple response with AI reply text",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatReplyResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatReplyResponse" }
              }
            }
          },
          "502": {
            "description": "AI Service Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatReplyResponse" }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/chat/process-memory": {
      "post": {
        "tags": ["Private"],
        "summary": "POST /api/chat/process-memory",
        "description": "/api/chat/process-memory\nProcess memory operations for a given AI reply text",
        "operationId": "ProcessMemory",
        "parameters": [],
        "requestBody": {
          "description": "The memory processing request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProcessMemoryRequest",
                "description": "The memory processing request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Memory operation results and profile auto-update info",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProcessMemoryResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProcessMemoryResponse" }
              }
            }
          },
          "502": {
            "description": "Server Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ProcessMemoryResponse" }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/chat/start-interview": {
      "post": {
        "tags": ["Private"],
        "summary": "POST /api/chat/start-interview",
        "description": "/api/chat/start-interview\nInitializes an interview session: returns the existing pending question if\nthe thread is already in-progress, otherwise calls AI for the first question,\nsaves it to both DBs, and returns it.",
        "operationId": "StartInterview",
        "parameters": [],
        "requestBody": {
          "description": "The start interview request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InterviewStartRequest",
                "description": "The start interview request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "First (or existing pending) interview question",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewStartResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewStartResponse" }
              }
            }
          },
          "502": {
            "description": "AI Service Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewStartResponse" }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/chat/interview": {
      "post": {
        "tags": ["Private"],
        "summary": "POST /api/chat/interview",
        "description": "/api/chat/interview\nUser submits an answer; server saves it, calls AI for the next question,\nsaves the AI question to both DBs, and returns it.",
        "operationId": "Interview",
        "parameters": [],
        "requestBody": {
          "description": "The interview message request",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/ChatRequest" },
                  {
                    "properties": {
                      "activityId": { "type": "string" }
                    },
                    "required": ["activityId"],
                    "type": "object"
                  }
                ],
                "description": "The interview message request"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Next interview question from AI",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewMessageResponse" }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewMessageResponse" }
              }
            }
          },
          "502": {
            "description": "AI Service Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InterviewMessageResponse" }
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/profile-views/{userId}": {
      "get": {
        "tags": ["Public", "Private"],
        "summary": "GET /api/profile-views/{userId}",
        "description": "/api/profile-views/{userId}\nGet the profile view for a user (composite view with sections and optionally memories)",
        "operationId": "GetProfileView",
        "parameters": [
          {
            "description": "The ID of the user",
            "in": "path",
            "name": "userId",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "in": "query",
            "name": "include",
            "required": false,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Profile view data with sections and optionally memories",
            "content": {
              "application/json": { "schema": {} }
            }
          },
          "404": {
            "description": "Profile not found",
            "content": {
              "application/json": { "schema": {} }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": { "schema": {} }
            }
          }
        },
        "security": []
      }
    },
