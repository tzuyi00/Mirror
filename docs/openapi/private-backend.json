    "/api/memories/{memoryId}": {
      "get": {
        "tags": ["Public", "Private"],
        "summary": "GET /api/memories/{memoryId}",
        "description": "Get a specific memory by ID",
        "operationId": "GetMemoryById",
        "parameters": [
          {
            "description": "The ID of the memory to retrieve",
