      "delete": {
        "tags": ["Private"],
        "summary": "DELETE /api/memories/{memoryId}",
        "description": "/api/memories/{memoryId}?mode=\"\"\nDelete a memory (soft or hard delete)",
        "operationId": "DeleteMemory",
        "parameters": [
          {
            "description": "The ID of the memory to delete",
            "in": "path",
            "name": "memoryId",
            "required": true,
            "schema": { "type": "string" }
          },
          {
            "description": "Delete mode: 'soft' (default, marks as deleted) or 'hard' (completely removes)",
            "in": "query",
            "name": "mode",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["soft", "hard"]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Deletion confirmation",
            "content": {
